{
  "name": "russrimmerman-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal blog and portfolio of Russ Rimmerman, Microsoft Cloud Solution Architect.",
  "author": "Russ Rimmerman",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "astro dev --host",
    "start": "astro dev --host",
    "build": "astro check && astro build",
    "check:site": "node scripts/check-site.mjs",
    "test": "npm run build && npm run check:site",
    "preview": "astro preview --host",
    "astro": "astro",
    "hero": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/generate-hero.mjs",
    "format": "prettier --write src api scripts .github/workflows .github/dependabot.yml astro.config.mjs package.json tsconfig.json public/site.webmanifest public/staticwebapp.config.json"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@azure/identity": "^4.13.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.7",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "reading-time": "^1.5.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3"
  },
  "packageManager": "npm@12.0.2+sha512.b885e890b9418fa1693544d05f53e64f9a73ec194837d4258b15fecdd692347b1dd2a517b1b0cbaf9d31cd8e92c3b70956bd2ecc72833a57b4b3098f5bfa7943"
}
