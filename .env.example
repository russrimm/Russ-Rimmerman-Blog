# Example environment file for local development.
# Copy to `.env` (gitignored) and fill in the values you need. Nothing here is
# required to build or run the site — each variable enables a specific feature.

# ---------------------------------------------------------------------------
# Azure OpenAI — used by `npm run hero` (post hero images) and
# `npm run figures` (explanatory in-article diagrams). Auth is Microsoft
# Entra ID / OIDC via DefaultAzureCredential (az login), so there is no API
# key to set here.
# ---------------------------------------------------------------------------

# Your Azure OpenAI resource endpoint (e.g. https://my-openai.openai.azure.com).
AZURE_OPENAI_ENDPOINT=

# Deployment name for the `gpt-image-1` image model used by both generators.
AZURE_OPENAI_IMAGE_DEPLOYMENT=

# Deployment name for a chat model. Optional for `npm run hero` (it falls back
# to tag/title heuristics), REQUIRED for `npm run figures` — the chat model is
# what reads the post and decides which sections need a diagram.
AZURE_OPENAI_CHAT_DEPLOYMENT=

# Optional: override the Azure OpenAI REST API version. Defaults to a known-good
# preview version pinned in `scripts/lib/azure-openai.mjs`.
AZURE_OPENAI_API_VERSION=

# ---------------------------------------------------------------------------
# Newsletter — used by the Azure Static Web Apps managed API function
# `api/src/functions/subscribe.js` (POST /api/subscribe).
# ---------------------------------------------------------------------------

# Which provider the /api/subscribe function should forward signups to.
# Set to `buttondown` to enable the form.
NEWSLETTER_PROVIDER=

# Buttondown API token (kept server-side; never exposed to the browser).
BUTTONDOWN_API_KEY=

# Comma-separated list of origins the /api/subscribe function accepts browser
# posts from. Required in production: Static Web Apps does not forward the
# public hostname to the managed function, so without this every browser
# submission is rejected as cross-origin. List every hostname the site is
# served from, including the *.azurestaticapps.net default.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Keystatic CMS — read by astro.config.mjs.
# ---------------------------------------------------------------------------
