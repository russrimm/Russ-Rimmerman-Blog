---
import { NAV_LINKS, SITE_TITLE, SOCIALS } from "@/consts";
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header
  class="border-ink-200/70 dark:border-ink-800/70 dark:bg-ink-950/80 sticky top-0 z-40 border-b bg-white/80 backdrop-blur-md"
>
  <nav
    class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4 sm:px-6"
    aria-label="Primary"
  >
    <a
      href="/"
      aria-label={`${SITE_TITLE} home`}
      class="group text-ink-900 inline-flex min-w-0 items-center gap-2 rounded-lg font-semibold dark:text-white"
    >
      <span
        class="text-gradient border-ink-200 group-hover:border-azure-300 dark:border-ink-700 dark:bg-ink-900 dark:group-hover:border-azure-600 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border bg-white text-base font-bold shadow-sm transition"
        aria-hidden="true"
      >
        RR
      </span>
      <span class="hidden truncate sm:inline">{SITE_TITLE}</span>
    </a>

    <div class="flex shrink-0 items-center gap-1 sm:gap-2">
      <ul class="hidden items-center gap-1 lg:flex">
        {
          NAV_LINKS.map(link => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class:list={[
                  "rounded-lg px-3 py-2 text-sm font-medium transition",
                  isActive(link.href)
                    ? "text-azure-600 dark:text-azure-400"
                    : "text-ink-600 hover:text-azure-600 dark:text-ink-300 dark:hover:text-azure-400",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href={SOCIALS.buymeacoffee}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden h-10 items-center gap-2 rounded-lg bg-[#FFDD00] px-3 text-sm font-semibold text-black shadow-sm transition hover:brightness-95 focus-visible:ring-2 focus-visible:ring-[#FFDD00]/50 xl:inline-flex"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M4 8h13a2 2 0 0 1 2 2 4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V8z"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linejoin="round"></path>
          <path
            d="M19 9h1.5a2.5 2.5 0 0 1 0 5H18"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path>
          <path
            d="M6 18h11"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path>
          <path
            d="M9 2.5c-.5.8-.5 1.5 0 2.3M12 2.5c-.5.8-.5 1.5 0 2.3M15 2.5c-.5.8-.5 1.5 0 2.3"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"></path>
        </svg>
        <span>Buy me a coffee</span>
      </a>

      <ThemeToggle />

      <a
        href="/search/"
        aria-label="Search"
        aria-current={pathname.startsWith("/search") ? "page" : undefined}
        class="text-ink-600 hover:bg-ink-50 hover:text-azure-600 dark:text-ink-300 dark:hover:bg-ink-900 dark:hover:text-azure-400 inline-flex h-10 w-10 items-center justify-center rounded-lg transition"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m21 21-4.3-4.3M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16Z"></path>
        </svg>
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        class="border-ink-200 text-ink-600 hover:border-azure-400 hover:text-azure-600 dark:border-ink-700 dark:text-ink-300 dark:hover:border-azure-500 dark:hover:text-azure-400 inline-flex h-10 w-10 items-center justify-center rounded-lg border transition lg:hidden"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="border-ink-200/70 dark:border-ink-800/70 dark:bg-ink-950/95 hidden border-t bg-white/95 lg:hidden"
  >
    <ul class="space-y-1 px-4 py-3 sm:px-6">
      {
        NAV_LINKS.map(link => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "block rounded-lg px-3 py-2.5 text-base font-medium transition",
                isActive(link.href)
                  ? "bg-azure-50 text-azure-600 dark:bg-ink-800 dark:text-azure-400"
                  : "text-ink-700 hover:bg-ink-50 dark:text-ink-200 dark:hover:bg-ink-800",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="border-ink-200 dark:border-ink-800 mt-2 border-t pt-2">
        <a
          href={SOCIALS.buymeacoffee}
          target="_blank"
          rel="noopener noreferrer"
          class="text-ink-700 hover:bg-ink-50 dark:text-ink-200 dark:hover:bg-ink-800 block rounded-lg px-3 py-2.5 text-base font-medium transition"
        >
          Buy me a coffee <span aria-hidden="true">↗</span>
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  let mobileMenuController: AbortController | undefined;

  function initMobileMenu() {
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    if (!btn || !menu || btn.dataset.bound === "true") return;
    mobileMenuController?.abort();
    mobileMenuController = new AbortController();
    const { signal } = mobileMenuController;
    btn.dataset.bound = "true";

    const setOpen = (open: boolean) => {
      menu.classList.toggle("hidden", !open);
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute(
        "aria-label",
        open ? "Close navigation menu" : "Open navigation menu"
      );
    };

    btn.addEventListener(
      "click",
      () => {
        setOpen(btn.getAttribute("aria-expanded") !== "true");
      },
      { signal }
    );

    const closeOnEscape = (event: KeyboardEvent) => {
      if (
        event.key !== "Escape" ||
        btn.getAttribute("aria-expanded") !== "true"
      ) {
        return;
      }
      setOpen(false);
      btn.focus();
    };

    document.addEventListener("keydown", closeOnEscape, { signal });
    document.addEventListener(
      "pointerdown",
      event => {
        if (
          btn.getAttribute("aria-expanded") !== "true" ||
          !(event.target instanceof Node) ||
          btn.contains(event.target) ||
          menu.contains(event.target)
        ) {
          return;
        }
        setOpen(false);
      },
      { signal }
    );

    const desktopQuery = window.matchMedia("(min-width: 1024px)");
    desktopQuery.addEventListener(
      "change",
      event => {
        if (event.matches) setOpen(false);
      },
      { signal }
    );
  }

  initMobileMenu();
  document.addEventListener("astro:after-swap", initMobileMenu);
</script>
