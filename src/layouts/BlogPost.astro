---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import TagList from "@/components/TagList.astro";
import Comments from "@/components/Comments.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import PostListItem from "@/components/PostListItem.astro";

interface Props {
  post: CollectionEntry<"blog">;
  readingTime: string;
  relatedPosts?: CollectionEntry<"blog">[];
}

const { post, readingTime, relatedPosts = [] } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, heroAlt, tags } =
  post.data;

// A trailing parenthetical (e.g. "Title (Subtitle)") renders on its own line
// in the post heading, while `title` stays a single clean string everywhere
// else (metadata, cards, RSS). Titles without one are unaffected.
const titleMatch = title.match(/^(.*?)\s+(\(.*\))$/);
const titleMain = titleMatch ? titleMatch[1] : title;
const titleAside = titleMatch ? titleMatch[2] : null;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  image={heroImage}
  imageAlt={heroAlt ?? title}
  tags={tags}
>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <header class="mb-8">
      <a
        href="/blog/"
        class="text-ink-500 hover:text-azure-600 dark:text-ink-400 dark:hover:text-azure-400 mb-6 inline-flex items-center gap-1 text-sm font-medium transition"
      >
        &larr; Back to blog
      </a>
      <h1
        class="text-ink-900 text-3xl font-bold tracking-tight text-balance sm:text-4xl dark:text-white"
      >
        {titleMain}
        {
          titleAside && (
            <span class="text-ink-500 dark:text-ink-400 mt-1 block text-2xl sm:text-3xl">
              {titleAside}
            </span>
          )
        }
      </h1>
      <div
        class="text-ink-500 dark:text-ink-400 mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm"
      >
        <FormattedDate date={pubDate} />
        <span aria-hidden="true">&middot;</span>
        <span>{readingTime}</span>
        <span aria-hidden="true">&middot;</span>
        <span>
          By <a
            href="/about/"
            rel="author"
            class="text-azure-600 dark:text-azure-400 font-medium hover:underline"
            >Russ Rimmerman</a
          >
        </span>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>
                Updated <FormattedDate date={updatedDate} />
              </span>
            </>
          )
        }
      </div>
      <TagList tags={tags} class="mt-4" />
    </header>

    {
      heroImage && (
        <Image
          src={heroImage}
          alt={heroAlt ?? title}
          widths={[480, 768, 1200]}
          sizes="(min-width: 768px) 768px, calc(100vw - 2rem)"
          loading="eager"
          fetchpriority="high"
          class="mb-10 aspect-[3/2] w-full rounded-2xl object-cover"
        />
      )
    }

    <div
      class="prose prose-lg dark:prose-invert prose-headings:font-semibold prose-pre:rounded-xl prose-pre:border prose-pre:border-ink-200 dark:prose-pre:border-ink-800 max-w-none"
    >
      <slot />
    </div>

    <div class="mt-16">
      <NewsletterSignup />
    </div>

    {
      relatedPosts.length > 0 && (
        <section
          class="border-ink-200/70 dark:border-ink-800/70 mt-16 border-t pt-10"
          aria-labelledby="related-posts-heading"
        >
          <h2
            id="related-posts-heading"
            class="text-ink-900 text-xl font-semibold dark:text-white"
          >
            Related articles
          </h2>
          <div class="divide-ink-200/70 dark:divide-ink-800/70 mt-4 divide-y">
            {relatedPosts.map(relatedPost => (
              <PostListItem post={relatedPost} />
            ))}
          </div>
        </section>
      )
    }

    <Comments />
  </article>
</BaseLayout>
